# ========================================================
# SmartKisan Backend Environment Template
# Copy this file to .env and configure your credentials
# ========================================================

# Server Port
PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=smartkisan_db

# Unified Database URL (Optional for Cloud MySQL such as Railway, Aiven, PlanetScale, Render)
# DATABASE_URL=mysql://root:root@localhost:3306/smartkisan_db

# Security & Session Secrets
JWT_SECRET=your_jwt_secret_key_here

# Email OTP & Contact Inquiry Service Credentials (Gmail SMTP & Vercel HTTPS Relay)
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_RELAY_HOST=smart-kisan-two.vercel.app
MAIL_RELAY_SECRET=smartkisan_internal_relay_secret_8829
CONTACT_DESTINATION_EMAIL=abraralimemon23@gmail.com

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://smart-kisan-two.vercel.app/api/login/oauth2/code/google
FRONTEND_URL=https://smart-kisan-two.vercel.app
